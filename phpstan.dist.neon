includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
#    - vendor/spaze/phpstan-disallowed-calls/extension.neon
#    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
#    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
#    - vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon
#    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon

parameters:
    level: 6
    paths:
        - src
    customRulesetUsed: false
    excludePaths:
        - */workbench/*
        - */tests/*
    # No ignoreErrors entries: the four that used to live here matched nothing, and PHPStan
    # reports an unmatched ignore pattern as an error, so the run failed regardless of the code.
    # Three of them targeted tests/, which excludePaths above removes from the analysis entirely,
    # and the fourth tried to silence the GitHubApi facade - now handled properly by @method
    # annotations on the facade itself. Add entries back if the errors they described reappear.

#    scanFiles:
#        - vendor/_laravel_idea/_ide_helper_facades.php
